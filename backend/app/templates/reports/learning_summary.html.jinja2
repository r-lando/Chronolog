<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Learning Summary</title>
<style>
  @page { margin: 2cm; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 11pt; color: #1a1a1a; }
  h1 { font-size: 20pt; margin-bottom: 0.1em; }
  h2 { font-size: 13pt; margin-top: 1.4em; border-bottom: 1px solid #ccc; padding-bottom: 0.2em; color: #2f4a6b; }
  .generated { color: #666; font-size: 9pt; }
  .stats-grid { display: flex; flex-wrap: wrap; gap: 10px; margin: 1em 0; }
  .stat { background: #f2f5f9; border-radius: 4px; padding: 10px 14px; min-width: 140px; }
  .stat .value { font-size: 18pt; font-weight: bold; color: #2f6ea3; }
  .stat .label { font-size: 8.5pt; color: #666; }
  table { width: 100%; border-collapse: collapse; margin-top: 0.5em; }
  th, td { text-align: left; border-bottom: 1px solid #ddd; padding: 4px 8px; font-size: 9.5pt; }
  .footer { margin-top: 3em; font-size: 8pt; color: #888; border-top: 1px solid #ddd; padding-top: 0.5em; }
  .empty { color: #888; font-style: italic; font-size: 9.5pt; }
</style>
</head>
<body>
  <h1>Learning Summary</h1>
  <p class="generated">Generated {{ generated_at }}</p>

  <div class="stats-grid">
    <div class="stat"><div class="value">{{ overview.labs_completed }}</div><div class="label">Labs completed</div></div>
    <div class="stat"><div class="value">{{ overview.ctf_challenges_solved }}</div><div class="label">CTF challenges solved</div></div>
    <div class="stat"><div class="value">{{ overview.total_learning_hours }}</div><div class="label">Learning hours</div></div>
    <div class="stat"><div class="value">{{ overview.skills_practiced }}</div><div class="label">Skills practiced</div></div>
    <div class="stat"><div class="value">{{ overview.tools_used }}</div><div class="label">Tools used</div></div>
    <div class="stat"><div class="value">{{ overview.techniques_practiced }}</div><div class="label">ATT&amp;CK techniques</div></div>
  </div>

  <h2>Labs by Category</h2>
  {% if labs_by_category %}
  <table><tr><th>Category</th><th>Count</th></tr>
    {% for p in labs_by_category %}<tr><td>{{ p.label }}</td><td>{{ p.count }}</td></tr>{% endfor %}
  </table>
  {% else %}<p class="empty">No practiced labs yet.</p>{% endif %}

  <h2>Top Skills Practiced</h2>
  {% if skills_practiced %}
  <table><tr><th>Skill</th><th>Labs</th></tr>
    {% for p in skills_practiced %}<tr><td>{{ p.label }}</td><td>{{ p.count }}</td></tr>{% endfor %}
  </table>
  {% else %}<p class="empty">No skills attached to practiced labs yet.</p>{% endif %}

  <h2>Top Tools Used</h2>
  {% if tools_used %}
  <table><tr><th>Tool</th><th>Labs</th></tr>
    {% for p in tools_used %}<tr><td>{{ p.label }}</td><td>{{ p.count }}</td></tr>{% endfor %}
  </table>
  {% else %}<p class="empty">No tools attached to practiced labs yet.</p>{% endif %}

  <h2>MITRE ATT&amp;CK Coverage by Tactic</h2>
  {% if mitre_coverage %}
  <table><tr><th>Tactic</th><th>Distinct techniques practiced</th></tr>
    {% for p in mitre_coverage %}<tr><td>{{ p.label }}</td><td>{{ p.count }}</td></tr>{% endfor %}
  </table>
  {% else %}<p class="empty">No MITRE techniques mapped to practiced labs yet.</p>{% endif %}

  <h2>Activity Over Time (labs completed per month)</h2>
  <table><tr><th>Month</th><th>Labs completed</th></tr>
    {% for p in activity_timeline %}<tr><td>{{ p.label }}</td><td>{{ p.count }}</td></tr>{% endfor %}
  </table>

  <div class="footer">Generated by TALA &mdash; a personal cybersecurity lab journal.</div>
</body>
</html>
