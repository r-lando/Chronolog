<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ title }} — Lab Report</title>
<style>
  @page { margin: 2cm; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; color: #1a1a1a; font-size: 11pt; line-height: 1.5; }
  h1 { font-size: 20pt; margin-bottom: 0.1em; }
  h2 { font-size: 13pt; margin-top: 1.5em; border-bottom: 1px solid #ccc; padding-bottom: 0.2em; color: #2f4a6b; }
  .meta { color: #555; font-size: 9pt; margin-bottom: 1.5em; }
  .badge { display: inline-block; background: #eef2f7; border-radius: 3px; padding: 2px 8px; font-size: 9pt; margin-right: 6px; }
  table { width: 100%; border-collapse: collapse; margin-top: 0.5em; }
  th, td { text-align: left; border-bottom: 1px solid #ddd; padding: 4px 8px; font-size: 9.5pt; vertical-align: top; }
  .finding { margin-bottom: 0.6em; padding: 8px; background: #f7f7f9; border-left: 3px solid #4a7fb5; }
  .severity-High { border-left-color: #c0524a; }
  .severity-Medium { border-left-color: #c99a3a; }
  .severity-Low, .severity-Info { border-left-color: #6b7280; }
  .evidence-img { max-width: 100%; margin: 8px 0; border: 1px solid #ddd; }
  .evidence-caption { font-size: 8.5pt; color: #666; margin-bottom: 1em; }
  .hash { font-family: 'Courier New', monospace; font-size: 7.5pt; }
  .footer { margin-top: 3em; font-size: 8pt; color: #888; border-top: 1px solid #ddd; padding-top: 0.5em; }
</style>
</head>
<body>
  <h1>{{ title }}</h1>
  <div class="meta">
    <span class="badge">{{ category }}</span>
    <span class="badge">{{ difficulty }}</span>
    <span class="badge">{{ status }}</span>
    {% if platform %}<span class="badge">{{ platform }}</span>{% endif %}
    <br>
    {% if date_started %}Started: {{ date_started }}{% endif %}
    {% if date_completed %} &middot; Completed: {{ date_completed }}{% endif %}
    {% if time_spent_minutes %} &middot; Time spent: {{ time_spent_minutes }} min{% endif %}
  </div>

  {% if objective_html %}<h2>Objective</h2>{{ objective_html | safe }}{% endif %}
  {% if environment_html %}<h2>Environment</h2>{{ environment_html | safe }}{% endif %}
  {% if methodology_html %}<h2>Methodology</h2>{{ methodology_html | safe }}{% endif %}

  <h2>Findings</h2>
  {% if findings_html %}{{ findings_html | safe }}{% endif %}
  {% for f in structured_findings %}
    <div class="finding severity-{{ f.severity or '' }}">
      <strong>{{ f.title }}</strong>{% if f.severity %} &mdash; {{ f.severity }}{% endif %}
      {% if f.description %}<p>{{ f.description }}</p>{% endif %}
    </div>
  {% endfor %}
  {% if not findings_html and not structured_findings %}<p><em>No findings recorded.</em></p>{% endif %}

  {% if analysis_html %}<h2>Analysis</h2>{{ analysis_html | safe }}{% endif %}

  {% if techniques %}
  <h2>MITRE ATT&amp;CK Techniques</h2>
  <table>
    <tr><th>ID</th><th>Name</th><th>Tactic</th><th>Justification</th></tr>
    {% for t in techniques %}
    <tr><td>{{ t.technique_id }}</td><td>{{ t.name }}</td><td>{{ t.tactic }}</td><td>{{ t.justification }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if skills or tools %}
  <h2>Skills &amp; Tools</h2>
  <p>
    {% if skills %}<strong>Skills:</strong> {{ skills | join(', ') }}<br>{% endif %}
    {% if tools %}<strong>Tools:</strong> {{ tools | join(', ') }}{% endif %}
  </p>
  {% endif %}

  {% if image_evidence or file_evidence %}
  <h2>Evidence</h2>
  {% for img in image_evidence %}
    <div>
      <img class="evidence-img" src="{{ img.data_uri }}" alt="{{ img.filename }}">
      <div class="evidence-caption">{{ img.filename }}{% if img.description %} &mdash; {{ img.description }}{% endif %}</div>
    </div>
  {% endfor %}
  {% if file_evidence %}
  <table>
    <tr><th>Filename</th><th>Type</th><th>Description</th><th>SHA-256</th></tr>
    {% for e in file_evidence %}
    <tr><td>{{ e.filename }}</td><td>{{ e.evidence_type }}</td><td>{{ e.description or '' }}</td><td class="hash">{{ e.sha256 }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% endif %}

  {% if lessons_learned_html %}<h2>Lessons Learned</h2>{{ lessons_learned_html | safe }}{% endif %}
  {% if reflection_html %}<h2>Reflection</h2>{{ reflection_html | safe }}{% endif %}
  {% if next_steps_html %}<h2>Next Steps</h2>{{ next_steps_html | safe }}{% endif %}

  <div class="footer">
    Generated by TALA on {{ generated_at }} &mdash; this is your own private export; it is not published anywhere automatically.
  </div>
</body>
</html>
